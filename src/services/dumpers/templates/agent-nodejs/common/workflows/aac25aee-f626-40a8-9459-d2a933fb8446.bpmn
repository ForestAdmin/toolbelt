<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:forest="https://app.forestadmin.com" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="Start_1"><bpmn:outgoing>flow_Start_1_applicant</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="applicant" name="Read the applicant file" forest:alternative="get-data" forest:automaticCompletion="false" forest:preRecordedArgs="{&quot;selectedRecordStepId&quot;:&quot;workflow-start&quot;,&quot;fieldNames&quot;:[&quot;applicant_identity&quot;,&quot;applicant_contact&quot;,&quot;applicant_profile&quot;,&quot;applicant_volumes&quot;]}" forest:description="Read all 4 of these fields of this KYC case (every one is needed): &quot;Applicant · Identity&quot;, &quot;Applicant · Contact&quot;, &quot;Applicant · Declared profile&quot; and &quot;Applicant · Expected volumes&quot;: who applies, how to reach them, what they declared (occupation, income, source of funds, residence, tax residence, PEP) and the money they expect to pay in and out each month."><bpmn:outgoing>flow_applicant_check_docs</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="check_docs" name="Check the documents" forest:alternative="trigger-action" forest:automaticExecution="true" forest:automaticCompletion="false" forest:description="Run &quot;Check documents&quot;: each paper on file is checked against the onboarding rules (ID valid, selfie, proof of address under 3 months, proof of income above 70k EUR a year); the result card lists each one, valid or what is wrong."><bpmn:outgoing>flow_check_docs_documents</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="documents" name="Read the document results" forest:alternative="get-data" forest:automaticCompletion="false" forest:preRecordedArgs="{&quot;selectedRecordStepId&quot;:&quot;workflow-start&quot;,&quot;fieldNames&quot;:[&quot;docs_complete&quot;,&quot;doc_id&quot;,&quot;doc_selfie&quot;,&quot;doc_address&quot;,&quot;doc_income&quot;]}" forest:description="Read all 5 of these fields of this KYC case (every one is needed): &quot;Documents · Complete&quot;, &quot;Documents · ID document&quot;, &quot;Documents · Selfie&quot;, &quot;Documents · Proof of address&quot; (less than 3 months old) and &quot;Documents · Proof of income&quot; (above 70k EUR a year)."><bpmn:outgoing>flow_documents_docs_ok</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="docs_ok" name="Documents complete?" forest:aiDecision="true" forest:description="Complete when &quot;Documents · Complete&quot; says &quot;✓ Yes&quot;. Missing or outdated when it starts with &quot;✗ No&quot;: a paper not received, or a proof of address older than 3 months."><bpmn:outgoing>flow_docs_ok_verify_id</bpmn:outgoing><bpmn:outgoing>flow_docs_ok_request_docs</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="request_docs" name="Request the missing documents" forest:alternative="trigger-action" forest:automaticCompletion="false" forest:description="Run &quot;Request missing documents&quot;: the request is pre-filled with what &quot;Documents · Complete&quot; lacks. The case waits on the client, out of the queue; the result card shows the request and its due date."><bpmn:outgoing>flow_request_docs_end_waiting</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_waiting" name="Waiting on the client"></bpmn:endEvent>
    <bpmn:serviceTask id="verify_id" name="Verify the ID document (Onfido)" forest:alternative="trigger-action" forest:automaticExecution="true" forest:automaticCompletion="false" forest:description="Run &quot;Verify document&quot;: Onfido checks each applicant's ID live and matches the selfie to it; one result card per ID."><bpmn:outgoing>flow_verify_id_ids_read</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ids_read" name="Read the ID check results" forest:alternative="get-data" forest:automaticCompletion="false" forest:preRecordedArgs="{&quot;selectedRecordStepId&quot;:&quot;workflow-start&quot;,&quot;fieldNames&quot;:[&quot;idcheck_result&quot;,&quot;idcheck_documents&quot;,&quot;idcheck_faces&quot;]}" forest:description="Read all 3 of these fields of this KYC case (every one is needed): &quot;ID checks · Result&quot;, &quot;ID checks · Documents&quot; and &quot;ID checks · Face match&quot;: each ID with its result and confidence, each selfie matched to its ID, and the overall result."><bpmn:outgoing>flow_ids_read_ids_ok</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ids_ok" name="ID document valid?" forest:description="Valid when &quot;ID checks · Result&quot; starts with &quot;✓ Passed&quot;. Not valid when it shows ✗ Failed or ⚠ Needs a closer look: ask for a new ID."><bpmn:outgoing>flow_ids_ok_screen</bpmn:outgoing><bpmn:outgoing>flow_ids_ok_request_id</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="request_id" name="Request a new ID document" forest:alternative="trigger-action" forest:automaticCompletion="false" forest:description="Run &quot;Request ID document&quot;: the applicant gets a request in the app to upload a valid ID, with the reason Onfido gave; the result card shows the request and its due date."><bpmn:outgoing>flow_request_id_end_waiting</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="screen" name="Screen the applicants (ComplyAdvantage)" forest:alternative="trigger-action" forest:automaticExecution="true" forest:automaticCompletion="false" forest:description="Run &quot;Screen against sanctions lists&quot;: the result card lists each name checked and any match."><bpmn:outgoing>flow_screen_screening</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="screening" name="Read the screening result" forest:alternative="get-data" forest:automaticCompletion="false" forest:preRecordedArgs="{&quot;selectedRecordStepId&quot;:&quot;workflow-start&quot;,&quot;fieldNames&quot;:[&quot;screening_result&quot;]}" forest:description="Read the field &quot;Screening · Result&quot; of this KYC case: each hit on the applicants (✗ open or confirmed, ○ cleared before), or no hit."><bpmn:outgoing>flow_screening_hit_open</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="hit_open" name="Open screening hit?" forest:aiDecision="true" forest:description="Open hit when &quot;Screening · Result&quot; lists a hit marked ✗ and &quot;open&quot;. Clear otherwise: &quot;✓ No hit&quot;, or only hits cleared before (○)."><bpmn:outgoing>flow_hit_open_risk_inputs</bpmn:outgoing><bpmn:outgoing>flow_hit_open_park</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="park" name="Park the case for screening" forest:alternative="trigger-action" forest:automaticExecution="true" forest:automaticCompletion="false" forest:description="Run &quot;Park for screening&quot;: the case leaves the onboarding queue until the screening team decides on the hit; the result card lists the open hits."><bpmn:outgoing>flow_park_end_screening</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_screening" name="Sent to screening"></bpmn:endEvent>
    <bpmn:serviceTask id="risk_inputs" name="Read the risk inputs" forest:alternative="get-data" forest:automaticCompletion="false" forest:preRecordedArgs="{&quot;selectedRecordStepId&quot;:&quot;workflow-start&quot;,&quot;fieldNames&quot;:[&quot;risk_rating_suggested&quot;,&quot;risk_hits&quot;,&quot;risk_pep&quot;,&quot;risk_residence&quot;,&quot;risk_funds&quot;,&quot;risk_volumes&quot;]}" forest:description="Read all 6 of these fields of this KYC case (every one is needed): &quot;Risk · Suggested rating&quot;, &quot;Risk · Screening hits&quot;, &quot;Risk · PEP&quot;, &quot;Risk · Residence&quot;, &quot;Risk · Occupation and funds&quot; and &quot;Risk · Income vs volumes&quot;."><bpmn:outgoing>flow_risk_inputs_rate</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="rate" name="Rate the risk" forest:alternative="trigger-action" forest:automaticCompletion="false" forest:description="Run &quot;Rate the risk&quot;: pick LOW, MEDIUM or HIGH (it starts on the suggested rating). Low when every &quot;Risk ·&quot; line shows ✓: no open hit, no PEP, living and paying tax in the EU, an occupation and source of funds that explain the money, and no more money expected in than the declared income. The result card lists the risk lines and the next step."><bpmn:outgoing>flow_rate_rated</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="rated" name="Read the rating decided" forest:alternative="get-data" forest:automaticCompletion="true" forest:preRecordedArgs="{&quot;selectedRecordStepId&quot;:&quot;workflow-start&quot;,&quot;fieldNames&quot;:[&quot;risk_decided&quot;]}" forest:description="Read the field &quot;Risk rating · Decided&quot; of this KYC case."><bpmn:outgoing>flow_rated_risk</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="risk" name="Low risk?" forest:optionConditions="{&quot;version&quot;:1,&quot;options&quot;:[{&quot;flowId&quot;:&quot;flow_risk_approve&quot;,&quot;aggregator&quot;:&quot;and&quot;,&quot;conditions&quot;:[{&quot;sourceStepId&quot;:&quot;rated&quot;,&quot;fieldName&quot;:&quot;risk_decided&quot;,&quot;operator&quot;:&quot;equal&quot;,&quot;value&quot;:&quot;LOW&quot;}]}],&quot;fallbackFlowId&quot;:&quot;flow_risk_signoff&quot;}" forest:description="Low when &quot;Risk rating · Decided&quot; is LOW: the operator approves. Medium or high: a senior signs off."><bpmn:outgoing>flow_risk_approve</bpmn:outgoing><bpmn:outgoing>flow_risk_signoff</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="signoff" name="Send to the senior sign-off queue" forest:alternative="trigger-action" forest:automaticExecution="true" forest:automaticCompletion="true" forest:description="Run &quot;Send for senior sign-off&quot;: the case leaves the onboarding queue for the &quot;Senior sign-off&quot; queue, where a senior officer takes it and runs Senior review."><bpmn:outgoing>flow_signoff_end_senior</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_senior" name="With a senior officer"></bpmn:endEvent>
    <bpmn:serviceTask id="approve" name="Approve KYC - Low risk" forest:alternative="trigger-action" forest:automaticCompletion="false" forest:description="Run &quot;Approve KYC - Low risk&quot;: the case was rated LOW. It refuses when a document, an ID or a screening hit is still open."><bpmn:outgoing>flow_approve_end_ok</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Customer onboarded"></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_Start_1_applicant" sourceRef="Start_1" targetRef="applicant" />
    <bpmn:sequenceFlow id="flow_applicant_check_docs" sourceRef="applicant" targetRef="check_docs" />
    <bpmn:sequenceFlow id="flow_check_docs_documents" sourceRef="check_docs" targetRef="documents" />
    <bpmn:sequenceFlow id="flow_documents_docs_ok" sourceRef="documents" targetRef="docs_ok" />
    <bpmn:sequenceFlow id="flow_docs_ok_verify_id" sourceRef="docs_ok" targetRef="verify_id" name="Complete" />
    <bpmn:sequenceFlow id="flow_docs_ok_request_docs" sourceRef="docs_ok" targetRef="request_docs" name="Missing or outdated" forest:buttonColor="yellow" />
    <bpmn:sequenceFlow id="flow_request_docs_end_waiting" sourceRef="request_docs" targetRef="end_waiting" />
    <bpmn:sequenceFlow id="flow_verify_id_ids_read" sourceRef="verify_id" targetRef="ids_read" />
    <bpmn:sequenceFlow id="flow_ids_read_ids_ok" sourceRef="ids_read" targetRef="ids_ok" />
    <bpmn:sequenceFlow id="flow_ids_ok_screen" sourceRef="ids_ok" targetRef="screen" name="Valid" />
    <bpmn:sequenceFlow id="flow_ids_ok_request_id" sourceRef="ids_ok" targetRef="request_id" name="Not valid" forest:buttonColor="yellow" />
    <bpmn:sequenceFlow id="flow_request_id_end_waiting" sourceRef="request_id" targetRef="end_waiting" />
    <bpmn:sequenceFlow id="flow_screen_screening" sourceRef="screen" targetRef="screening" />
    <bpmn:sequenceFlow id="flow_screening_hit_open" sourceRef="screening" targetRef="hit_open" />
    <bpmn:sequenceFlow id="flow_hit_open_risk_inputs" sourceRef="hit_open" targetRef="risk_inputs" name="Clear" />
    <bpmn:sequenceFlow id="flow_hit_open_park" sourceRef="hit_open" targetRef="park" name="Open hit" forest:buttonColor="orange" />
    <bpmn:sequenceFlow id="flow_park_end_screening" sourceRef="park" targetRef="end_screening" />
    <bpmn:sequenceFlow id="flow_risk_inputs_rate" sourceRef="risk_inputs" targetRef="rate" />
    <bpmn:sequenceFlow id="flow_rate_rated" sourceRef="rate" targetRef="rated" />
    <bpmn:sequenceFlow id="flow_rated_risk" sourceRef="rated" targetRef="risk" />
    <bpmn:sequenceFlow id="flow_risk_approve" sourceRef="risk" targetRef="approve" name="Low" />
    <bpmn:sequenceFlow id="flow_risk_signoff" sourceRef="risk" targetRef="signoff" name="Fallback" />
    <bpmn:sequenceFlow id="flow_signoff_end_senior" sourceRef="signoff" targetRef="end_senior" />
    <bpmn:sequenceFlow id="flow_approve_end_ok" sourceRef="approve" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="160" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="applicant_di" bpmnElement="applicant"><dc:Bounds x="256" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_docs_di" bpmnElement="check_docs"><dc:Bounds x="416" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="documents_di" bpmnElement="documents"><dc:Bounds x="576" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="docs_ok_di" bpmnElement="docs_ok"><dc:Bounds x="736" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_docs_di" bpmnElement="request_docs"><dc:Bounds x="846" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_waiting_di" bpmnElement="end_waiting"><dc:Bounds x="1006" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verify_id_di" bpmnElement="verify_id"><dc:Bounds x="1102" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ids_read_di" bpmnElement="ids_read"><dc:Bounds x="1262" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ids_ok_di" bpmnElement="ids_ok"><dc:Bounds x="1422" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_id_di" bpmnElement="request_id"><dc:Bounds x="1532" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="screen_di" bpmnElement="screen"><dc:Bounds x="1692" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="screening_di" bpmnElement="screening"><dc:Bounds x="1852" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hit_open_di" bpmnElement="hit_open"><dc:Bounds x="2012" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="park_di" bpmnElement="park"><dc:Bounds x="2122" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_screening_di" bpmnElement="end_screening"><dc:Bounds x="2282" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="risk_inputs_di" bpmnElement="risk_inputs"><dc:Bounds x="2378" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rate_di" bpmnElement="rate"><dc:Bounds x="2538" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rated_di" bpmnElement="rated"><dc:Bounds x="2698" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="risk_di" bpmnElement="risk"><dc:Bounds x="2858" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="signoff_di" bpmnElement="signoff"><dc:Bounds x="2968" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_senior_di" bpmnElement="end_senior"><dc:Bounds x="3128" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve"><dc:Bounds x="3224" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ok_di" bpmnElement="end_ok"><dc:Bounds x="3384" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_Start_1_applicant_di" bpmnElement="flow_Start_1_applicant"><di:waypoint x="196" y="160" /><di:waypoint x="256" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_applicant_check_docs_di" bpmnElement="flow_applicant_check_docs"><di:waypoint x="356" y="160" /><di:waypoint x="416" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_docs_documents_di" bpmnElement="flow_check_docs_documents"><di:waypoint x="516" y="160" /><di:waypoint x="576" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_documents_docs_ok_di" bpmnElement="flow_documents_docs_ok"><di:waypoint x="676" y="160" /><di:waypoint x="736" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_docs_ok_verify_id_di" bpmnElement="flow_docs_ok_verify_id"><di:waypoint x="786" y="160" /><di:waypoint x="1102" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_docs_ok_request_docs_di" bpmnElement="flow_docs_ok_request_docs"><di:waypoint x="786" y="160" /><di:waypoint x="846" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_request_docs_end_waiting_di" bpmnElement="flow_request_docs_end_waiting"><di:waypoint x="946" y="160" /><di:waypoint x="1006" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_verify_id_ids_read_di" bpmnElement="flow_verify_id_ids_read"><di:waypoint x="1202" y="160" /><di:waypoint x="1262" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ids_read_ids_ok_di" bpmnElement="flow_ids_read_ids_ok"><di:waypoint x="1362" y="160" /><di:waypoint x="1422" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ids_ok_screen_di" bpmnElement="flow_ids_ok_screen"><di:waypoint x="1472" y="160" /><di:waypoint x="1692" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ids_ok_request_id_di" bpmnElement="flow_ids_ok_request_id"><di:waypoint x="1472" y="160" /><di:waypoint x="1532" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_request_id_end_waiting_di" bpmnElement="flow_request_id_end_waiting"><di:waypoint x="1632" y="160" /><di:waypoint x="1006" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_screen_screening_di" bpmnElement="flow_screen_screening"><di:waypoint x="1792" y="160" /><di:waypoint x="1852" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_screening_hit_open_di" bpmnElement="flow_screening_hit_open"><di:waypoint x="1952" y="160" /><di:waypoint x="2012" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hit_open_risk_inputs_di" bpmnElement="flow_hit_open_risk_inputs"><di:waypoint x="2062" y="160" /><di:waypoint x="2378" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_hit_open_park_di" bpmnElement="flow_hit_open_park"><di:waypoint x="2062" y="160" /><di:waypoint x="2122" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_park_end_screening_di" bpmnElement="flow_park_end_screening"><di:waypoint x="2222" y="160" /><di:waypoint x="2282" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_risk_inputs_rate_di" bpmnElement="flow_risk_inputs_rate"><di:waypoint x="2478" y="160" /><di:waypoint x="2538" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rate_rated_di" bpmnElement="flow_rate_rated"><di:waypoint x="2638" y="160" /><di:waypoint x="2698" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rated_risk_di" bpmnElement="flow_rated_risk"><di:waypoint x="2798" y="160" /><di:waypoint x="2858" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_risk_approve_di" bpmnElement="flow_risk_approve"><di:waypoint x="2908" y="160" /><di:waypoint x="3224" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_risk_signoff_di" bpmnElement="flow_risk_signoff"><di:waypoint x="2908" y="160" /><di:waypoint x="2968" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_signoff_end_senior_di" bpmnElement="flow_signoff_end_senior"><di:waypoint x="3068" y="160" /><di:waypoint x="3128" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_end_ok_di" bpmnElement="flow_approve_end_ok"><di:waypoint x="3324" y="160" /><di:waypoint x="3384" y="160" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

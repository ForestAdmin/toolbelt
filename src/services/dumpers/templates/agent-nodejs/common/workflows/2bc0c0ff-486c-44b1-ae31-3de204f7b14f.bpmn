      <bpmndi:BPMNShape id="draft_di" bpmnElement="draft"><dc:Bounds x="1948" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mlro_di" bpmnElement="mlro"><dc:Bounds x="2108" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mlro_read_di" bpmnElement="mlro_read"><dc:Bounds x="2204" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mlro_decide_di" bpmnElement="mlro_decide"><dc:Bounds x="2364" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="file_di" bpmnElement="file"><dc:Bounds x="2474" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_filed_di" bpmnElement="end_filed"><dc:Bounds x="2634" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_back_di" bpmnElement="send_back"><dc:Bounds x="2730" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_sent_back_di" bpmnElement="end_sent_back"><dc:Bounds x="2890" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="no_sar_di" bpmnElement="no_sar"><dc:Bounds x="2986" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_closed_di" bpmnElement="end_closed"><dc:Bounds x="3146" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="exit_di" bpmnElement="exit"><dc:Bounds x="3242" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_exit_di" bpmnElement="end_exit"><dc:Bounds x="3402" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_Start_1_assign_di" bpmnElement="flow_Start_1_assign"><di:waypoint x="196" y="160" /><di:waypoint x="256" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_assign_case_di" bpmnElement="flow_assign_case"><di:waypoint x="356" y="160" /><di:waypoint x="416" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_case_signals_di" bpmnElement="flow_case_signals"><di:waypoint x="516" y="160" /><di:waypoint x="576" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_signals_activity_di" bpmnElement="flow_signals_activity"><di:waypoint x="676" y="160" /><di:waypoint x="736" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_activity_profile_di" bpmnElement="flow_activity_profile"><di:waypoint x="836" y="160" /><di:waypoint x="896" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_profile_requests_di" bpmnElement="flow_profile_requests"><di:waypoint x="996" y="160" /><di:waypoint x="1056" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_requests_need_info_di" bpmnElement="flow_requests_need_info"><di:waypoint x="1156" y="160" /><di:waypoint x="1216" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_need_info_outcome_di" bpmnElement="flow_need_info_outcome"><di:waypoint x="1266" y="160" /><di:waypoint x="1838" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_need_info_ask_di" bpmnElement="flow_need_info_ask"><di:waypoint x="1266" y="160" /><di:waypoint x="1326" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_need_info_edd_di" bpmnElement="flow_need_info_edd"><di:waypoint x="1266" y="160" /><di:waypoint x="1582" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ask_end_ask_di" bpmnElement="flow_ask_end_ask"><di:waypoint x="1426" y="160" /><di:waypoint x="1486" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_edd_end_edd_di" bpmnElement="flow_edd_end_edd"><di:waypoint x="1682" y="160" /><di:waypoint x="1742" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_outcome_draft_di" bpmnElement="flow_outcome_draft"><di:waypoint x="1888" y="160" /><di:waypoint x="1948" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_outcome_no_sar_di" bpmnElement="flow_outcome_no_sar"><di:waypoint x="1888" y="160" /><di:waypoint x="2986" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_outcome_exit_di" bpmnElement="flow_outcome_exit"><di:waypoint x="1888" y="160" /><di:waypoint x="3242" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_draft_mlro_di" bpmnElement="flow_draft_mlro"><di:waypoint x="2048" y="160" /><di:waypoint x="2108" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mlro_mlro_read_di" bpmnElement="flow_mlro_mlro_read"><di:waypoint x="2144" y="160" /><di:waypoint x="2204" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mlro_read_mlro_decide_di" bpmnElement="flow_mlro_read_mlro_decide"><di:waypoint x="2304" y="160" /><di:waypoint x="2364" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mlro_decide_file_di" bpmnElement="flow_mlro_decide_file"><di:waypoint x="2414" y="160" /><di:waypoint x="2474" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_mlro_decide_send_back_di" bpmnElement="flow_mlro_decide_send_back"><di:waypoint x="2414" y="160" /><di:waypoint x="2730" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_file_end_filed_di" bpmnElement="flow_file_end_filed"><di:waypoint x="2574" y="160" /><di:waypoint x="2634" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_send_back_end_sent_back_di" bpmnElement="flow_send_back_end_sent_back"><di:waypoint x="2830" y="160" /><di:waypoint x="2890" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_no_sar_end_closed_di" bpmnElement="flow_no_sar_end_closed"><di:waypoint x="3086" y="160" /><di:waypoint x="3146" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_exit_end_exit_di" bpmnElement="flow_exit_end_exit"><di:waypoint x="3342" y="160" /><di:waypoint x="3402" y="160" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
